# Copy to .env and edit. Never commit .env. None of these values are ever sent to the frontend.

# --- Admin endpoints (/api/admin/*) are DISABLED until this is set. Use a long random string:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Optional: Google Places API (New). Without it, everything else still works.
# Enables per-restaurant live reviews (max 5, not stored) and the closure-check verification pass.
GOOGLE_PLACES_API_KEY=

# --- Storage (SQLite by default; a PostgreSQL URL works too, e.g. postgresql+psycopg://user:pass@host/foodspotter)
# DATABASE_URL=sqlite:///data/foodspotter.db

# --- Overpass (OpenStreetMap) politeness
# OVERPASS_MIN_INTERVAL_SECONDS=5
# OVERPASS_CACHE_HOURS=24

# --- Scheduled discovery (off by default). Interval in hours; respects the same rate limits.
# ENABLE_SCHEDULER=true
# DISCOVERY_INTERVAL_HOURS=168

# --- CORS origins allowed to call the API (comma separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ranking weights (renormalised over the components that have data)
# W_RATING=0.35
# W_VOLUME=0.25
# W_SENTIMENT=0.30
# W_RECENCY=0.10

# --- Sentiment engine: auto = BERT only when it has scored >=95% of matched reviews, else the VADER baseline.
# SENTIMENT_ENGINE=auto            # auto | vader | bert
# ENABLE_BERT=false                # true: also run BERT after every refresh (needs backend/requirements-bert.txt)
# BERT_MODEL_ID=nlptown/bert-base-multilingual-uncased-sentiment
# BERT_MODEL_REVISION=             # pin a Hugging Face commit for reproducible results
# BERT_BATCH_SIZE=16
# BERT_MAX_LENGTH=512
